---
// Starlight `Footer` override: the standard Starlight footer plus the project
// nav, so every page carries the path back to the project.
import StarlightFooter from '@astrojs/starlight/components/Footer.astro';

import { project } from '../project.js';
import ProjectNav from './ProjectNav.astro';
---

<StarlightFooter />
<footer class="if-project-footer">
  <ProjectNav />
  <p>Part of the {project.title} project.</p>
</footer>

<style>
  .if-project-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
  }

  p {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
</style>
